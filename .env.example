# =============================================================================
# School Inbox — environment configuration (names only; never commit real values)
# =============================================================================
# Copy to .env.local and fill in what you have. The marketing site renders with
# NO configuration at all. Server features (checkout, webhook, database, email)
# report a clear NOT_CONFIGURED error rather than failing silently or pretending
# to succeed. Release 0 does NOT require inbound-email or AI provider keys.
# -----------------------------------------------------------------------------

# --- Application ---------------------------------------------------------------
# Canonical public origin, e.g. https://schoolinbox.example. Used to build
# Stripe redirect URLs and absolute links. Falls back to http://localhost:3000.
NEXT_PUBLIC_APP_URL=

# --- Supabase (database, auth, private storage) --------------------------------
# Release 0 stores orders and onboarding. Without these, onboarding falls back to
# a clearly-labelled in-memory store for local development only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser. Grants row-level-security bypass.
SUPABASE_SERVICE_ROLE_KEY=
# Optional direct connection string for running migrations locally.
DATABASE_URL=

# --- Stripe (payments) ---------------------------------------------------------
# Use a test-mode secret key (sk_test_...) for Release 0.
STRIPE_SECRET_KEY=
# Signing secret for the /api/webhooks/stripe endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Price IDs created in the Stripe dashboard. The one-time Rescue is required for
# checkout to function. Care/Care Plus are optional in Release 0.
STRIPE_RESCUE_PRICE_ID=
STRIPE_CARE_PRICE_ID=
STRIPE_CARE_PLUS_PRICE_ID=
# Optional: price ID for the per-additional-child add-on (kept configurable).
STRIPE_ADDITIONAL_CHILD_PRICE_ID=

# --- Email (transactional) -----------------------------------------------------
# Provider is isolated behind an adapter. "resend" or "postmark" or "console".
# "console" (the default when unset) logs emails to the server console for local
# development and never sends anything.
EMAIL_PROVIDER=console
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS="School Inbox <hello@schoolinbox.example>"
# Where paid-order + onboarding notifications are sent for the operations team.
OPERATIONS_NOTIFICATION_EMAIL=

# --- Operations console access -------------------------------------------------
# Shared secret gating the /ops routes in Release 0 (before full operator auth
# arrives in Release 1). Set a long random value in any deployed environment.
OPS_ACCESS_TOKEN=

# --- Reserved for later releases (leave blank in Release 0) --------------------
# Inbound email webhook (Release 2)
INBOUND_WEBHOOK_SECRET=
# AI extraction provider (Release 2)
AI_PROVIDER_API_KEY=
# Error monitoring
ERROR_MONITORING_DSN=

# --- Public analytics ----------------------------------------------------------
# Analytics never receives child names, school names, source or action content.
# When unset, funnel events are logged to the console in development only.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
