# BotAssure CX - environment variable reference
#
# PRD ref: 1.2 (".env.example containing names and descriptions only, never real
# secrets") and 14.7.
#
# Copy to .env.local and fill in values from each vendor's dashboard.
# NEVER commit a filled-in copy. Production secrets belong in the deployment
# platform's secret manager, not in a file.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Absolute public origin, no trailing slash. Used for canonical URLs,
# hreflang alternates and billing redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# Brand (all configurable; "BotAssure CX" is a working name pending clearance)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_LEGAL_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_SECURITY_EMAIL=
# Set to true ONLY after professional trademark, corporate-name and domain
# clearance is complete. Controls the working-name notice in the footer.
BRAND_NAME_CLEARANCE_COMPLETED=false

# ---------------------------------------------------------------------------
# Database, auth and storage (Supabase)
# ---------------------------------------------------------------------------

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Anonymous key. Safe for the browser; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. SERVER ONLY. Bypasses RLS, so every code path using it must
# validate organization scope explicitly (16.2). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Billing (Stripe or equivalent)
# ---------------------------------------------------------------------------

BILLING_SECRET_KEY=
BILLING_WEBHOOK_SECRET=
NEXT_PUBLIC_BILLING_PUBLISHABLE_KEY=

# Provider price IDs, one per self-serve package. The application NEVER sends
# an amount at checkout; it sends the price ID, and the provider is the
# authority on what is charged.
BILLING_PRICE_ID_ESSENTIAL_AUDIT=
BILLING_PRICE_ID_BILINGUAL_PRO_AUDIT=
BILLING_PRICE_ID_CONTINUOUS_ASSURANCE=

# ---------------------------------------------------------------------------
# Transactional email (Resend or equivalent)
# ---------------------------------------------------------------------------

EMAIL_API_KEY=
# Must be on a domain with SPF, DKIM and DMARC configured.
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO_ADDRESS=

# ---------------------------------------------------------------------------
# AI evaluation
# ---------------------------------------------------------------------------

# anthropic | none. "none" disables AI-assisted scoring; analysts score
# manually, which is a supported operating mode (15.6).
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Configure the client with sendDefaultPii disabled: logs and error reports must
# contain no transcripts, policy content or credentials (16.1, 23.3).
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Limits and retention (16.5)
# ---------------------------------------------------------------------------

MAX_UPLOAD_BYTES=20000000
EVIDENCE_RETENTION_DAYS=90

# ---------------------------------------------------------------------------
# Feature flags (1.1.5)
#
# All default to false. An unset flag is OFF, so a forgotten value can never
# enable an unfinished or higher-risk capability in production.
# ---------------------------------------------------------------------------

FEATURE_BROWSER_RUNNER=false
FEATURE_API_CAPTURE=false
FEATURE_AI_EVALUATION=false
FEATURE_SCHEDULED_MONITORING=false
FEATURE_REPORT_SHARE_LINKS=false
FEATURE_CUSTOMER_MFA_ENFORCEMENT=false
FEATURE_ANALYTICS=false

# Global execution kill switch (FR-RUN-004). When "true", no new outbound test
# execution starts. Report access, billing and sign-in are unaffected.
EXECUTION_KILL_SWITCH=false
