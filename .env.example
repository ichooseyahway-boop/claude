# =============================================================================
# BotAssure CX - environment variable reference
# =============================================================================
# PRD 1.1 rule 3 and PRD 14.7.
#
# This file documents NAMES AND DESCRIPTIONS ONLY. It must never contain a real
# secret, key, token, connection string or production identifier. Production
# values live in the deployment platform's secret manager and are rotated after
# exposure or staff changes.
#
# Copy to `.env.local` for local development and fill in development/test-mode
# values only. Local development must use synthetic data (PRD 14.6).
# -----------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
# Absolute public base URL, no trailing slash. Used for callback URLs, canonical
# tags, hreflang and email links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# One of: development | preview | staging | production (PRD 14.6).
# Preview and staging must never point at production data stores.
APP_ENVIRONMENT="development"

# --- Database / Auth / Storage (Supabase) -----------------------------------
# Project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=""
# Publishable/anon key. Safe to expose to the browser; RLS is the real control.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service-role key. SERVER ONLY. Never import into a client bundle. Every code
# path using it must pass an explicit organization scope (PRD 16.2).
SUPABASE_SERVICE_ROLE_KEY=""
# Private storage bucket for evidence objects and uploaded policy sources.
SUPABASE_STORAGE_BUCKET="botassure-private"

# --- Billing (Stripe) --------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
# Webhook signing secret. Required; unsigned webhooks are rejected (FR-BILL-002).
STRIPE_WEBHOOK_SECRET=""
# Return URLs for hosted checkout and the hosted billing portal.
STRIPE_CHECKOUT_SUCCESS_PATH="/app?checkout=complete"
STRIPE_CHECKOUT_CANCEL_PATH="/en-CA/pricing"

# --- Transactional email (Resend or equivalent) ------------------------------
EMAIL_API_KEY=""
EMAIL_FROM_ADDRESS="no-reply@example.invalid"
EMAIL_REPLY_TO_ADDRESS="support@example.invalid"
# Shared secret used to verify inbound delivery/bounce webhooks.
EMAIL_WEBHOOK_SECRET=""

# --- AI evaluation provider --------------------------------------------------
# Provider identifier resolved by the AIProvider adapter: anthropic | echo
# `echo` is the deterministic offline stub used by tests and local development.
AI_PROVIDER="echo"
AI_PROVIDER_API_KEY=""
# Model identifier recorded against every evaluation for reproducibility
# (FR-EVAL-004).
AI_MODEL_ID=""
# Hard ceilings that bound cost and blast radius (PRD 15.5).
AI_MAX_INPUT_CHARS="24000"
AI_MAX_OUTPUT_TOKENS="4000"
AI_MAX_RETRIES="2"
AI_REQUEST_TIMEOUT_MS="60000"

# --- Background jobs ---------------------------------------------------------
# Shared secret for signed, short-lived internal job authentication (PRD 13.3).
JOB_SIGNING_SECRET=""
JOB_MAX_ATTEMPTS="5"
JOB_DEAD_LETTER_ALERT_THRESHOLD="1"

# --- Observability -----------------------------------------------------------
# Error monitoring DSN. Configure the client with PII scrubbing enabled; never
# forward transcripts, policy content or findings (PRD 19.4).
SENTRY_DSN=""
LOG_LEVEL="info"

# --- Product analytics -------------------------------------------------------
# Privacy-conscious analytics. Event properties carry internal IDs and safe
# categories only (PRD 19.4).
NEXT_PUBLIC_ANALYTICS_HOST=""
NEXT_PUBLIC_ANALYTICS_KEY=""

# --- Limits and retention ----------------------------------------------------
# Upload constraints for knowledge sources (FR-ONB-004).
UPLOAD_MAX_BYTES="26214400"
UPLOAD_ALLOWED_MIME="application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/csv"
# Retention defaults in days (PRD 16.5). Product defaults, not legal advice.
RETENTION_TRANSCRIPT_DAYS="90"
RETENTION_LEAD_DAYS="90"
RETENTION_REPORT_MONTHS="24"
RETENTION_AUDIT_EVENT_MONTHS="12"
RETENTION_UPLOAD_STAGING_HOURS="24"

# --- Outbound test execution safety -----------------------------------------
# Global kill switch for automated outbound test execution (FR-RUN-004).
# When "true", no new outbound test job may start. Report access and billing
# administration remain available.
EXECUTION_KILL_SWITCH="false"
# Comma-separated extra hosts the API adapter may reach. Loopback, link-local,
# metadata and private-network destinations are blocked regardless (FR-RUN-003).
ADAPTER_HOST_ALLOWLIST=""
ADAPTER_TIMEOUT_MS="30000"
ADAPTER_MAX_RESPONSE_BYTES="1048576"

# --- Feature flags -----------------------------------------------------------
# Post-launch modules stay disabled in production until their gates pass
# (PRD 1.1 rule 5, FR-RUN-006).
FLAG_BROWSER_RUNNER="false"
FLAG_REPORT_SHARE_LINKS="false"
FLAG_CUSTOMER_MFA_ENFORCEMENT="false"
FLAG_ENTERPRISE_SSO="false"
